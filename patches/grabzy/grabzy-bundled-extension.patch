--- a/extensions/browser/updater/extension_downloader.cc
+++ b/extensions/browser/updater/extension_downloader.cc
@@ -347,6 +347,18 @@
     AddToFetches(fetches_preparing, std::move(task));
   pending_tasks_.clear();
 
+  // Grabzy.CC: ungoogled-chromium starts no update check here, so no extension
+  // phones home. Start only checks against our server, for the extension this
+  // browser installs (chrome/browser/extensions/external_provider_impl.cc).
+  // Every other check is still dropped.
+  for (auto& fetch_list : fetches_preparing) {
+    for (auto& fetch : fetch_list.second) {
+      const GURL& url = fetch->base_url();
+      if (url.SchemeIs("https") && url.host() == "api.grabzy.cc") {
+        StartUpdateCheck(std::move(fetch));
+      }
+    }
+  }
