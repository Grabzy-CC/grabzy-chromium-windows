Install the Grabzy.CC extension in every profile and keep it updated from
api.grabzy.cc, the way Chrome installs and updates from its web store.

- external_provider_impl.cc: a provider that offers the extension by update
  URL (https://api.grabzy.cc/extension/update.xml), installed by default and
  acknowledged, so there is no "new extension added" prompt. brand.py writes
  the extension ID in from branding/extension-id.txt; while that holds no ID,
  nothing is installed.
- extension_downloader.cc: ungoogled-chromium starts no extension update
  check at all. Start them again for https://api.grabzy.cc only; every other
  check is still dropped.
- safe_manifest_parser.cc: the update manifest's XML namespace contains
  google.com, which domain substitution would rewrite after the patches, and
  then no update manifest would parse. Split the literal so it stays as is.

--- a/chrome/browser/extensions/external_provider_impl.cc
+++ b/chrome/browser/extensions/external_provider_impl.cc
@@ -106,6 +106,36 @@
 using ::base::i18n::LanguageTag;
 using ::base::i18n::LanguageTagConverter;
 
+// Grabzy.CC: the extension this browser installs in every profile and keeps
+// updated from api.grabzy.cc. branding/brand.py writes the ID in at build time
+// from branding/extension-id.txt; while it is empty, nothing is installed.
+const char kGrabzyExtensionId[] = "";
+const char kGrabzyExtensionUpdateUrl[] =
+    "https://api.grabzy.cc/extension/update.xml";
+
+// Offers that one extension by update URL, as ExtensionMigrator offers Docs
+// Offline: the extension downloader then fetches its CRX from our server.
+class GrabzyExtensionLoader : public ExternalLoader {
+ public:
+  GrabzyExtensionLoader() = default;
+  GrabzyExtensionLoader(const GrabzyExtensionLoader&) = delete;
+  GrabzyExtensionLoader& operator=(const GrabzyExtensionLoader&) = delete;
+
+  void StartLoading() override {
+    base::DictValue prefs;
+    if (crx_file::id_util::IdIsValid(kGrabzyExtensionId)) {
+      base::DictValue entry;
+      entry.Set(ExternalProviderImpl::kExternalUpdateUrl,
+                kGrabzyExtensionUpdateUrl);
+      prefs.Set(kGrabzyExtensionId, std::move(entry));
+    }
+    LoadFinished(std::move(prefs));
+  }
+
+ private:
+  ~GrabzyExtensionLoader() override = default;
+};
+
