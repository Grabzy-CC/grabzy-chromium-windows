+#ifndef CHROME_BROWSER_GRABZY_GRABZY_UPDATER_H_
+#define CHROME_BROWSER_GRABZY_GRABZY_UPDATER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "url/gurl.h"
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+// Keeps the browser on the newest Grabzy.CC release. A few minutes after
+// startup and then every six hours it reads the latest release of this
+// platform's repo on GitHub. When that is not the running build, it downloads
+// the platform's file, checks it against the SHA-256 GitHub lists for it, and
+// installs it so the next launch runs the new version:
+//   Windows  runs the installer silently; Chromium swaps in new_chrome.exe
+//            when the browser restarts.
+//   macOS    a small shell waits for the browser to quit, then replaces the
+//            app bundle with the one from the disk image.
+//   Linux    replaces the AppImage file in place.
+// Off with --disable-grabzy-update or --disable-background-networking.
+class GrabzyUpdater {
+ public:
+  GrabzyUpdater();
+  GrabzyUpdater(const GrabzyUpdater&) = delete;
+  GrabzyUpdater& operator=(const GrabzyUpdater&) = delete;
+  ~GrabzyUpdater();
+
+  void Start();
+
+ private:
+  void Check();
+  void OnRelease(std::optional<std::string> body);
+  void OnCanInstall(std::string tag, GURL url, std::string digest, bool ok);
+  void OnDownloaded(std::string tag, std::string digest, base::FilePath file);
+  void OnInstalled(std::string tag, bool ok);
+  void Finish();
+
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::RepeatingTimer timer_;
+  bool busy_ = false;
+  // A release installed in this session that takes over on the next launch.
+  std::string staged_tag_;
+  base::WeakPtrFactory<GrabzyUpdater> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_GRABZY_GRABZY_UPDATER_H_
