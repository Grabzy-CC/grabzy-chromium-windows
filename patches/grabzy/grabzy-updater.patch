+#ifndef CHROME_BROWSER_GRABZY_RELEASE_TAG_H_
+#define CHROME_BROWSER_GRABZY_RELEASE_TAG_H_
+
+namespace grabzy {
+
+// The release this build ships as, like "156.0.8078.79-1-grabzy.1". The build
+// pipeline writes it in; "dev" turns the updater off for local builds.
+inline constexpr char kReleaseTag[] = "dev";
+
+}  // namespace grabzy
